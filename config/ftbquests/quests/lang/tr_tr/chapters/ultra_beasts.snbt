	task.1E6F0000000011C1.title: "Bir Poipole Yakala"
	quest.1E6F000000001199.quest_desc: ["&8Other&r'da &5Ultra Wormhole'lar&r uyarı vermeden açılır; bunlar Ultra Beast'lerin yaşadığı yabancı boyuta geçitlerdir.\\n\\nYaklaşık saatte bir bir solucan deliği oluşur ve içinden güçlendirilmiş, yüksek seviyeli bir patron olarak bir Ultra Beast çıkar. Onu zayıflat, ardından yarık kapanmadan yakala. Ne bir tapınak ne de çağırma eşyası vardır; gökyüzü yarıldığında orada olman yeterlidir. Bir &dCanavar Topu&r sana en iyi yakalama şansını verir."]
	quest.1E6F000000001199.title: "&5Ultra Wormhole'lar"
	quest.1E6F00000000119C.quest_desc: ["&fNihilego&r, denizanası gibi süzülen bir Ultra Beast'tir. Bir konağa yapışıp zehriyle zihnini çarpıtan bir parazit olduğu düşünülür.\\n\\nOther'daki bir Ultra Wormhole'da onu gözle ve ortaya çıktığında alt et."]
	quest.1E6F0000000011A0.quest_desc: ["&cBuzzwole&r, Şişkin Pokémon'dur; grotesk kaslardan oluşan bu Ultra Beast, şişkin bedenini ani ve zemini çatlatan pozlarla sergiler.\\n\\nBir Ultra Wormhole'dan zorla çıktığında onu yakala."]
	quest.1E6F0000000011A4.quest_desc: ["&fPheromosa&r, Zarif Pokémon'dur; olağanüstü hızlı ve zarif bu Ultra Beast, kirli hiçbir şeyin kendisine dokunmasına izin vermez.\\n\\nKaçıp gitmeden önce bir Ultra Wormhole'da peşine düş."]
	quest.1E6F0000000011A8.quest_desc: ["&eXurkitree&r, Işıldayan Pokémon'dur; canlı kablolardan oluşan bir yumağa benzeyen bu Ultra Beast, elektrikli bedenini beslemek için bütün elektrik şebekelerini tüketir.\\n\\nBir Ultra Wormhole'dan fırlayıp çıktığında onu yakala."]
	quest.1E6F0000000011AC.quest_desc: ["&aCelesteela&r, Fırlatılan Pokémon'dur; roket şeklindeki bu devasa Ultra Beast'in havalanırken çevresindeki ormanları kavurduğu söylenir.\\n\\nOther'daki bir Ultra Wormhole'da onu alt et."]
	quest.1E6F0000000011B0.quest_desc: ["&2Kartana&r, Çekilmiş Kılıç Pokémon'dur; origami gibi katlanmış bu Ultra Beast, tek darbede çelik bir kuleyi kesebilecek kadar keskindir.\\n\\nBir Ultra Wormhole'dan keserek kendine yol açtığında onu yakala."]
	quest.1E6F0000000011B4.quest_desc: ["&8Guzzlord&r, Çöp Yiyen Pokémon'dur; binaları, dağları, denizi, her şeyi yiyip bitiren bu devasa Ultra Beast hiç doymuyor gibi görünür.\\n\\nBir Ultra Wormhole'da bu oburla yüzleş ve onu yakala."]
	quest.1E6F0000000011B8.quest_desc: ["&7Stakataka&r, Sur Pokémon'dur; üst üste yığılmış yaratıklardan oluşan yüksek bir duvarın harekete geçmiş hâline benzeyen bir Ultra Beast'tir.\\n\\nBir Ultra Wormhole'da onu devir ve takımına kat."]
	quest.1E6F0000000011BC.quest_desc: ["&dBlacephalon&r, Havai Fişek Pokémon'dur; göz kamaştırıcı bir gösteriyle insanları yakınına çeken, ardından onları dağıtmak için kendi başını patlatan bir Ultra Beast'tir.\\n\\nBir Ultra Wormhole'dan patlarcasına çıktığında onu yakala."]
	quest.1E6F0000000011C0.quest_desc: ["&5Poipole&r, Zehir İğnesi Pokémon'dur; heyecanlandığında zehirli dikenler fırlatan, nadir ve tuhaf biçimde sevecen bir Ultra Beast'tir.\\n\\nBir Ultra Wormhole'da onu yakala; yeterince dostlukla yetiştirirsen tehditkâr &5Naganadel&r'e evrimleşir."]
}

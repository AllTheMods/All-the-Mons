	quest.072329284468B14C.quest_desc: ["Borrius bölgesinde yenmen gereken son kişi, &6Eğitmen Blue&r. \\\\n\\\\n&4&oRadical Red&r oynadıysan &6Eğitmen Red&r'i hatırlayabilirsin; ona çok benzer. \\\\n\\\\nOnunla savaşmak isteğe bağlıdır. Bu nedenle özel bir eşyası yoktur; bunun yerine onu yine End şehirlerinin bulunduğu belirli biyomlarda bulman gerekir. \\\\n\\\\nOnu yenebilirsen bir sürü ödül alırsın; ayrıca Borrius Efsanesi olursun!"]
	quest.1A3CF2D85E20CA99.quest_desc: [
		"Cidden &6Wayne&r, seviyemi artırmayı unutmaya devam edeceksen seninle savaşmaya hevesli değilim!"
		""
		"Özel eşyası Bağlantı Kablosudur."
	]
	quest.1CE0095340328C08.quest_desc: ["Hâlâ tatmin olmadın mı? Daha da fazla eğitmen mi yenmen gerekiyor? \\n\\nBattleground'da isteğe bağlı olarak savaşabileceğin daha fazla eğitmen bulunur! Bunlar da End şehirlerinin oluştuğu yerlerde ortaya çıkar. \\n\\nBunlar &5Battleground Alice&f, &5Battleground Benjamin&f, &5Battleground Big Mo&f, &5Battleground Mel&f, &5Battleground Mirskle&f, &5Battleground Tessy&f ve &5Battleground Vega&r'dır. \\nHepsini yenerek Battleground'u kazan!"]
	quest.1CE0095340328C08.title: "Battleground Gladyatörü"
	quest.201F9E2D3FF0533F.quest_desc: [
		"Seviye artışı yok."
		""
		"Özel eşyası Black Apricorn Sprout'tur."
	]
	quest.3B750DFAF99B858A.quest_desc: ["&4&oUnbound&r'u açmak için &4&oRadical Red&r veya &4&oBDSP&r'den birini tamamlaman gerekir. \\\\n\\\\nBunlar &4&oUnbound&r'dan önce gelen iki &4&oSeridir&r. Birini tamamlayana kadar &4Trainer Associate&r sana &4&oUnbound&r'u sunmaz. \\\\n\\\\nDoğru duydun; ikisini birden değil, yalnızca birini bitirmen gerekiyor!"]
	quest.3B750DFAF99B858A.title: "&4&oRadical Red'i Tamamla"
	quest.4160EC0860E9CA4C.quest_desc: ["&4&oUnbound&r, ikinci nesil oyunların birinci nesille aynı hikâyeyi izlemesine bir tepki olarak oluşturuldu. \\\\n\\\\nFirered ile aynı mekanikler; sadece yeni &cPokémonlar&r ve en önemlisi yeni bir hikâye! \\\\n\\\\nHer zamanki gibi &4Trainer Card&r'ını bir &4Trainer Associate&r'e ver; sana &4&oUnbound&r'a ayarlanmış şekilde geri verecektir."]
	quest.4160EC0860E9CA4C.title: "&4&oUnbound"
	quest.45686EA3EC85C958.quest_desc: ["&4&oUnbound&r'u açmak için &4&oRadical Red&r veya &4&oBDSP&r'den birini tamamlaman gerekir. \\\\n\\\\nBunlar &4&oUnbound&r'dan önce gelen iki &4&oSeridir&r. Birini tamamlayana kadar &4Trainer Associate&r sana &4&oUnbound&r'u sunmaz. \\\\n\\\\nDoğru duydun; ikisini birden değil, yalnızca birini bitirmen gerekiyor!"]
	quest.45686EA3EC85C958.title: "&4&oBDSP'yi Tamamla"
	quest.49264B6A20E2657E.quest_desc: [
		"Burada seviye artışı yok; bu adam gerçekten çok cimri!"
		""
		"Özel eşyası Binding Band'dir."
	]
	quest.554FADF336FF2D04.title: "&7Light of Ruin Vega"
	quest.65E76C4AD74338E4.quest_desc: [
		"Hâlâ seviye artışı yok mu? Neyi yanlış yaptık?"
		""
		"Bu seferki özel eşyası Dire Hit'tir."
	]
	quest.76CA3D98A4772886.quest_desc: ["&4&oSeri&r bitmiş olabilir ama &5Şampiyon&r olarak kalmak istiyorsan unvanını korumak için savaşmalısın! \\\\n\\\\nDaha önce sana yenilenlerden bazıları intikam almak ve &5Şampiyon&r unvanını ele geçirmek için geri dönüyor! \\\\n\\\\nBunlar: &5Title Defense Jax&f, &5Title Defense Marlon&f, &5Title Defense Milo&f, &5Title Defense Solenk&f, &5Title Defense Wayne&f ve &5Title Defense Zeph&r. \\\\n\\\\nBunlarla savaşmak isteğe bağlı olduğu için ne yazık ki özel eşyaları yoktur. Bunun yerine belirli biyomlarda rastgele ortaya çıkarlar. (İpucu: Hepsi End şehirlerinin oluşabildiği biyomlardır.) \\\\n\\\\nHepsini yenersen Borrius Unvanını alırsın!"]
	quest.76CA3D98A4772886.title: "Hâlâ &5Şampiyon&r!"
	quest.7D88BBE64DC2A9D0.quest_desc: [
		"Seviye artışı yok... Neden en az seviye artışı bu &4&oSeride&r var?"
		""
		"Özel eşyası Karanlık Taşıdır."
	]
}

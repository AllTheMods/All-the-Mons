{
	quest.070CAEAD49B8DBA3.quest_desc: ["8 İstif &7Compressed Iron Block&r ve bir &6&lATM Yıldızı&r karşılığında &5Creative &7Compressed Iron Block&r elde edebilirsin! \\n\\nBu, ayarlanmasını istediğin herhangi bir sıcaklığa ayarlanabilir ve Makinelerinde kullanılabilir. \\n\\n8 İstif &7Compressed Iron Block&r, 4,608 &7Compressed Iron Ingot&r'a eşittir... iyi şanslar!"]
	quest.070CAEAD49B8DBA3.title: "&5&lCreative &7Compressed Iron Blocks"
	quest.1D87415343E65AA7.quest_desc: ["&5Creative &8Compressor&r istediğin Bar Pressure'ı seçmene olanak sağlar! Pozitif, negatif, hatta 0! Makinelerin içinde kullanılabilir. \\n\\n4 istif Advanced Pressure Tubes, bir Advanced Liquid Compressor, Advanced Air Compressor, Electrostatic Compressor ve Flux Compressor'a ihtiyacın olacak. \\n\\nHangisi daha zor bilmiyorum: &6&lATM Yıldızı'nı&r elde etmek mi, yoksa bunu yapmak için gereken tüm malzemeleri hatırlamak mı!"]
	quest.1D87415343E65AA7.title: "&5&lCreative &8Compressor"
	quest.228CB313BAB6406E.quest_desc: ["Görünüşe göre bunun varsayılan olarak bir tarifi yokmuş! Sanki mod geliştiricisi, &5Creative&r Locomotive'leri Hayatta Kalma modunda kullanmanızı istememiş gibi. \\n\\nÇok güçlü olduklarını düşünmedim, bu yüzden &5Trenlerinizin&r tadını çıkarın! \\n\\nNormal &3Lokomotifler&r gibi çalışırlar, yalnızca Yakıt veya Enerji gerekmez! Sadece &6Raylar&r gerekir."]
	quest.228CB313BAB6406E.title: "&5&lCreative &8Locomotive"
	quest.23DE60E57136C207.quest_desc: ["En kolay sınırsız Enerji deposu. Sadece 4 &3Energy Battery&r (&3&lID&r'den) ve bir &6&lATM Yıldızı'na&r ihtiyaç duyar! \\n\\nHepsini &2&lMinecraft&r'ın kaldırabileceği kadar Enerji ile enerjilendirmen gerekecek... Tam anlamıyla tam sayı (integer) sınırı!"]
	quest.23DE60E57136C207.title: "&5&lCreative &3Energy Battery"
	quest.36ABE142039E712B.quest_desc: ["Bu normal sonsuz enerji deposu gibi çalışır. Sadece bu, sistemine bağlanabilir! Sisteminin yeterli güce sahip olup olmadığı konusunda asla endişelenmene gerek yok! Ve buna &5Kuantum Zırhı&r da dahildir.  \\n\\n4 &dSüper Yoğun Enerji Hücresine&r ve bir &6&lATM Yıldızı'na&r ihtiyacın olacak. Her &dSüper Yoğun Enerji Hücresi&r, 8 &dYoğun Enerji Hücresi'ne&r ihtiyaç duyar. Her &dYoğun Enerji Hücresi&r, 8 &dEnerji Hücresi'ne&r ihtiyaç duyar. \\n\\n256 &dEnerji Hücresi&r... artı çok fazla enerji!"]
	quest.36ABE142039E712B.title: "&5&lYaratıcı Mod &dEnerji Hücresi"
	quest.3BB0926C4C00BE1D.quest_desc: ["Sırt roketindeki enerjinin bitmesi canını sıkmıyor mu? Artık bu konuda endişelenmene gerek yok! \\n\\nİlk başta bundan önceki her Sırt Roketini, bir &6&lATM Yıldızı'nı&r, artı daha pahalı Eşyalar yapman gerekebilir ama hey buna değer! \\n\\nSadece tak ve normal şekilde kullan. Üstelik şarjla daha az uğraşarak."]
	quest.3BB0926C4C00BE1D.title: "&5&lCreative Sırt Roketi"
	quest.3FF61A4D7A250AE1.quest_desc: ["Bu &5Enerji Hücresi (Yaratıcı Mod)&r için (diğer &5Yaratıcı Mod Enerji Hücresi&r ile karıştırılmamalı) 4 &cEnerji Hücresi (Nitro)&r gerekir. \\n\\nHer &cEnerji Hücresi (Nitro)&r, 2 &aEnerji Hücresi (Ruhlu)&r; her &aEnerji Hücresi (Ruhlu)&r da 2 &bEnerji Hücresi (Niotik)&r gerektirir. Bu, bir süre böyle devam eder... \\n\\nBu matematiği yapmayacağım. Tarif Ağacını kontrol et. Yapacak daha önemli işlerim var!"]
	quest.3FF61A4D7A250AE1.quest_subtitle: "Sınırsız Güç!"
	quest.3FF61A4D7A250AE1.title: "&l&cEnerji Hücresi &5(Yaratıcı Mod)"
	quest.405D2571E61694FD.quest_desc: ["Bir &dPatrick Arısı'na&r &6&lATM Yıldızı Bloğu&r ile Sağ Tıkladığında bir &6Yıldızlı Arı&r elde edeceksin! \\n\\nTozlaşmaları için bir &6&lATM Yıldızı Bloğu'na&r daha ihtiyacın olacak... Muhtemelen bunu sana daha önce söylemeliydim... \\n\\n&6Yıldızlı Arılar&r, &6Yıldızlı Peteği&r üretecek; bunları daha sonra Santrifüjde işleyerek nadiren &6ATM Yıldızı Parçaları&r elde edebilirsin!"]
	quest.405D2571E61694FD.title: "&6Yıldızlı Arı&r!"
	quest.4F7F0A5162D70082.quest_desc: ["Kafan karışmasın. Dolu ve boş olmak üzere 2 tane &5Yaratıcı Mod &aEnerji Küpü&r var. \\n\\n&aBoş Küpler&r bir Enerji Çöp Tenekesi olarak çalışır ve içine aktarılan tüm Enerjiyi yok eder. \\n\\n&aDolu Küpler&r sonsuz bir enerji deposu olarak çalışır. Ancak bunu yapmak için &aboş Enerji Küplerine&r ihtiyacın olacak... ve bunlar pahalı! \\n\\n&6&lATM Yıldızı&r ile 4 &aboş Enerji Küpünü&r enerjilendirerek bir tane dolu olanı elde edebilirsin."]
	quest.4F7F0A5162D70082.title: "&5&lYaratıcı Mod &aEnerji Küpü"
	quest.66E88F916B638B3B.quest_desc: ["Bu biraz kafa karıştırıcı olabilir. Oldukça fazla &5Creative &eSpellbook&r var! Ama bizim istediğimiz &d&lAllTheArcanist Gear&r'daki büyü kitabı. \\n\\nBu &eBüyü Kitabını&r, &l&dArs Nouveau&r modunun &eArchmage Büyü Kitabı&r, &6&lATM Yıldızı&r ve birkaç ek eşya kullanarak doğrudan üretebilirsin. Önce Ars Nouveau'nun yaratıcı büyü kitabını üretmen gerekmez. \\n\\n&eUnobtainium Spell Book&r ile aynı konfigürasyonlara sahip ancak sonsuz Mana'sı var ve tüm Gliflerin kilidi açık! \\n\\nTüm büyü gücü benim! BWAHAHAHAHA!"]
	quest.66E88F916B638B3B.title: "&5&lCreative &eSpellbook"
	quest.6C16670D16113DE9.quest_desc: ["&6&lATM Yıldızı&r üretimini otomatikleştirmek için &6ATM Yıldızı Parçalarına&r ihtiyacımız olacak. &6ATM Yıldızı Parçaları&r elde etmek için &6Yıldızlı Arılara&r ihtiyacımız olacak. \\n\\nVe tabii ki &6Yıldızlı Arıları&r elde etmek için &dPatrick Arılarına&r ihtiyacımız olacak! Sıcak Okyanuslarda balık tutarak nadiren &dPatrick Arılarını&r elde edebilirsin! \\nEğer onları dönüştürmek istemiyorsan, onlarla bir &dPatrick &aYıldızı&r çiftliği kurabilirsin."]
	quest.6C16670D16113DE9.title: "&dPatrick &aYıldızı&r... Arı?"
	quest.3D78D9F4E8A60EDB.quest_subtitle: "Önce bunu elde et!"
	quest.3D78D9F4E8A60EDB.title: "&5&lYaratıcı &dKaynak &fKavanozu"
	quest.5436157FDFC9633E.title: "Tamamen Otomatikleştirilmiş &6&lATM Yıldızı"
	quest.73201E591C2A40CC.title: "&6ATM Yıldızı Parçaları&r"
	quest.7C9154EF6068BE27.title: "Ama neden?"
	quest.08EC6BAB5CC07513.quest_desc: ["55 eşyayı birleştirip 1 eşya yapmamız gerekiyor... çalışma masası için biraz fazla büyük gibi! \\n\\nYıldızımızı yapmak için &6&lCreate&r modundan &6Mekanik İmalatçılar&r gerekecek. Toplam 55 tane, 9x9 yıldız biçiminde. Artık ters de durabilir! \\n\\nYönlerini değiştirmek için yanlarına &6&lCreate&r Ayarlı Anahtarıyla sağ tıklayarak bütün &6İmalatçıların&r bağlı olduğundan emin ol. Hepsinin tek bir son noktaya yönelmesi gerekir. \\n\\nBütün eşyalar yerleştirilip her &6İmalatçıya&r &dDönel Güç&r verildiğinde &6&lATM Yıldızı&r oluşur!"]
	quest.3D78D9F4E8A60EDB.quest_desc: ["Şimdilik oldukça basit bir tarif: yalnızca tamamen &dKaynak&r ile dolu 4 &5Unobtainium&r &dKaynak Kavanozu&r, 4 &dKaynak Cevher Bloğu&r ve bir &6&lYıldız&r gerekiyor. Merak etme, bu tarif değiştirilip daha da zorlaştırılacak! \\n\\nBu kavanoz her zaman &dKaynak&r ile doludur ve &dKaynak&r gerektiren her şeye bağlanabilir. &6&lATM Yıldızı&r çok bloklu yapıları da buna dâhil."]
	quest.5436157FDFC9633E.quest_desc: ["55 &6Yıldız Parçasıyla&r &6&lATM Yıldızlarını&r %100 otomatik olarak yeniden oluşturabiliriz! \\n\\nArtık bu &5Yaratıcı&r eşyaları üretmek çok kolay olacak!"]
	quest.73201E591C2A40CC.quest_desc: ["Artık &6Yıldız Parçalarını&r elde ettiğine göre &6&lYıldızlarımızı&r yeniden yapmak için farklı parçaları üretmeye başlayabilirsin! \\n\\nToplam 55 &6Yıldız Parçasıyla&r 1 &6&lYıldız&r yapabilirsin... umarım iyi bir Arı düzeneğin vardır!"]
	quest.7C9154EF6068BE27.quest_desc: ["Teknik olarak Ezici ile &6&lATM Yıldızını&r 5 &6Yıldız Parçasına&r dönüştürebilirsin... \\n\\nAma yeni bir &6&lYıldız&r yapmak için 55 tane gerekiyor... \\n\\nÖyleyse neden yapasın ki?"]
}
